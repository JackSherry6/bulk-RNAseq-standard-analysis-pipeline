params {
    // Reads and references
    reads = "s3://your-bucket/ref_files/*_R[12].fastq.gz"
    genome = "s3://your-bucket/ref_files/GRCh38.primary_assembly.genome.fa"
    gtf = "s3://your-bucket/ref_files/gencode.v45.primary_assembly.annotation.gtf"

    // Output directory (can also be S3)
    outdir = "s3://your-bucket/results/"
}

profiles {
    conda {
        conda.enabled = true
    }

    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
    }

    aws {
        process {
            executor = 'awsbatch'

            // AWS Batch parameters
            queue = 'your-aws-batch-queue'
            region = 'us-east-1' // replace with your region
            jobRole = 'arn:aws:iam::123456789012:role/YourBatchJobRole'

            withLabel: process_single {
                cpus = 1
                memory = '2 GB'
            }

            withLabel: process_low {
                cpus = 4
                memory = '8 GB'
            }

            withLabel: process_medium {
                cpus = 8
                memory = '16 GB'
            }

            withLabel: process_high {
                cpus = 16
                memory = '32 GB'
            }
        }
    }

    local {
        process.executor = 'local'
    }
}

executor {
    $aws {
        // optional default executor parameters
        queueSize = 10
    }
    $local {
        cpus = 1
    }
}

resume = true
